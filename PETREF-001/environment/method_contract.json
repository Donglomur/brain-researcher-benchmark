  "scans": [
    {
      "subject": "sub-01",
      "session": "ses-baseline"
    },
    {
      "subject": "sub-01",
      "session": "ses-rescan"
    },
    {
      "subject": "sub-02",
      "session": "ses-baseline"
    },
    {
      "subject": "sub-02",
      "session": "ses-rescan"
    }
  ],
  "source_columns": [
    "left_putamen",
    "right_putamen",
    "left_cerebellum_cortex",
    "right_cerebellum_cortex"
  ],
  "activity_units": "Bq/mL",
  "target_region": "putamen_equal_hemisphere",
  "reference_region": "cerebellar_cortex_equal_hemisphere",
  "aggregation": "unweighted_arithmetic_mean_of_two_hemisphere_TACs",
  "preprocessing": {
    "pvc": "nopvc",
    "tac_variant": "desc-mc",
    "time_units": "minutes",
    "observation": "source_frame_midpoint",
    "initial_zero_frames": "retain",
    "origin": [
      0,
      0
    ],
    "reference_reconstruction": "piecewise_linear_origin_and_midpoints",
    "frame_average_forward_model": false,
    "normalization": "divide_both_TACs_by_maximum_reference"
  },
  "model": {
    "name": "SRTM-PWL-midpoint",
    "parameter_order": [
      "R1",
      "k2",
      "BP_ND"
    ],
    "theta": "k2/(1+BP_ND)",
    "z_initial": 0,
    "z_ode": "dz/dt=C_R-theta*z",
    "prediction": "R1*C_R+(k2-R1*theta)*z",
    "integration": "analytic_piecewise_linear_exponential_convolution",
    "k2_units": "min^-1",
    "k2prime": "k2/R1"
  },
  "fit": {
    "objective": "unweighted_sum_squared_normalized_frame_residuals",
    "residual": "prediction_minus_observed",
    "bounds_lower": [
      0.01,
      0.0001,
      -0.5
    ],
    "bounds_upper": [
      3,
      5,
      15
    ],
    "bounds_interpretation": "numerical_not_physiological",
    "starts": [
      [
        1,
        0.05,
        0.5
      ],
      [
        1,
        0.2,
        2
      ],
      [
        1,
        0.8,
        5
      ]
    ],
    "method": "trf",
    "jac": "3-point",
    "x_scale": 1,
    "loss": "linear",
    "ftol": 1e-10,
    "xtol": 1e-10,
    "gtol": 1e-10,
    "max_nfev": 5000,
    "selection": "lowest_SSE_successful_finite_in_bounds_candidate_then_start_index",
    "bound_flag_atol": "1e-7*max(1,upper-lower)",
    "bound_flag_rtol": 0
  },
  "summary": {
    "scan_mean": "equal_weight_all_four_scans",
    "pair_percent": "100*abs(baseline-rescan)/pair_mean",
    "nonpositive_pair_mean": "undefined_nonpositive_mean",
    "headline_percent": "equal_weight_two_pairs_only_if_both_defined",
    "population_reliability_claim": false
  },
  "tolerances": {
    "source": {
      "atol": 1e-10,
      "rtol": 1e-9
    },
    "parameters": {
      "R1_atol": 0.000001,
      "k2_atol": 1e-7,
      "BP_ND_atol": 0.000001,
      "rtol": 0.00001
    },
    "normalized_prediction": {
      "atol": 1e-7,
      "rtol": 0.000001
    },
    "normalized_arithmetic": {
      "atol": 1e-8,
      "rtol": 0.000001
    },
    "summary_atol": 0.000001,
    "percent_atol": 0.00001
  }
}
