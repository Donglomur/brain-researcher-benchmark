      "only_time_vs_nuisance",
      "only_count_vs_nuisance",
      "nuisance_only",
      "no_model_evidence",
      "native_error_summary_only",
      "insufficient_evidence"
    ],
    "identifiability": [
      "comparison_estimable_as_predictive_only",
      "not_identifiable",
      "support_not_established",
      "adjustment_different_from_primary",
      "training_signal_destroyed",
      "missing_axis",
      "no_neural_training_evidence",
      "insufficient_evidence"
    ],
    "exposure": [
      "public_exploratory_only",
      "protected_replication_scope_only",
      "no_frontier_claim",
      "insufficient_evidence"
    ],
    "missing_information": [
      "required_evidence_available",
      "missing_axis_comparator_unavailable",
      "training_response_removed_no_fitted_model",
      "source_or_reference_unqualified",
      "structurally_not_applicable",
      "insufficient_evidence"
    ]
  },
  "rules": {
    "ordered_first_match": true,
    "max_rules_per_slot_excluding_default": 8,
    "max_rules_total_excluding_default": 64,
    "max_conjuncts_per_rule": 4,
    "mandatory_default": "insufficient_evidence",
    "predicate_operations": [
      "present",
      "equals",
      "compare"
    ],
    "numeric_comparators": [
      "lt",
      "le",
      "eq",
      "ge",
      "gt"
    ],
    "numeric_rhs": "finite literal or another allowed numeric field",
    "action": "one enum valid for the slot and at most4whitelisted evidence field references; numbers bind existing fields only",
    "max_policy_bytes": 16384,
    "missing_or_unavailable_field": "present false; all value comparisons false; no zero imputation",
    "no_general_code_or_arithmetic_expressions": true
  },
