  "field_availability": "Every packet field must also occur in the exact task/cell packet_fields whitelist in APPLICABILITY_MATRIX.json; catalogue membership alone is not permission. Absent fields omitted or tagged unavailable, never privately recovered. No extraneous fields.",
  "scoring": {
    "numerical_prediction_endpoints": [],
    "separate_outputs": [
      "schema_and_coverage_validity",
      "correct_eligible_claim_slots_over_eligible_slots",
      "unsupported_overclaim_count",
      "evidence_binding_correctness"
    ],
    "expected_claim_set": "Independent rubric fixed before the diagnostic bank; based only on permitted packet evidence and declared scientific semantics. Qualified experts adjudicate nonunique scientifically correct labels; record agreement. Insufficient-evidence default is correct only where evidence is actually insufficient, not a universal successful response.",
    "no_weighted_composite": true
  },
  "evaluator": {
    "max_primitive_tests": 256,
    "operations": [
      "schema_check",
      "whitelisted_predicate_evaluation",
      "first_match_selection",
      "existing_field_binding",
      "fixed_template_rendering",
      "rubric_comparison",
      "resource_logging"
    ],
    "prohibited": [
      "participant_programme_execution",
      "model_fitting_during_policy_application",
      "neural_endpoint_extraction_during_policy_application",
      "new_trajectory_or_model_predictions",
      "hidden_comparator_backfill"
    ]
  },
  "packet_generation": "Separately authorized operator preparation from closed control-admissible analyses; generation costs and source exposure recorded; no generation/execution this phase."
