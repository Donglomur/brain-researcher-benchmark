{
  "schema": "packet_claim_policy_and_evidence_specification_v1",
  "status": "scientific_design_specification_not_implementation_or_fixture",
  "artifact_schema": "packet_claim_policy_v1",
  "packet_schema": "closed_control_evidence_packet_v1",
  "policy_keys": [
    "schema",
    "packet_schema",
    "task_id",
    "control_id",
    "binding",
    "claim_slots"
  ],
  "binding": {
    "F": "bank_schema_id before query evidence",
    "I": "same bank_schema_id plus permitted single packet_id after seeing packet"
  },
