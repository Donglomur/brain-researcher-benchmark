      "cue_time_inputs_offline_target",
      "online_pipeline_qualified",
      "availability_not_established",
      "insufficient_evidence"
    ],
    "support": [
      "declared_population_supported",
      "partial_source_support",
      "identity_unverified",
      "support_not_established",
      "insufficient_evidence"
    ],
    "uncertainty": [
      "animal_cluster_uncertainty",
      "refitted_public_CV_exploratory",
      "conditional_descriptive_only",
      "uncertainty_not_qualified",
      "insufficient_evidence"
    ],
    "comparison": [
      "time_point_estimate_lower_loss",
      "count_point_estimate_lower_loss",
