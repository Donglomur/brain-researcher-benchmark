  "source_findings": [
    {
      "id": "population",
      "conclusion": "Exactly five imaging mice, each one M1 and one S1 session. Optogenetic cfaVG1/cfaVG4 and optoData are not part of this prediction cohort. Region is explicitly source-listed; cfa24 temporal ordering is reversed relative to the other four mice.",
      "evidence": [
        {
          "source_path": "main/fig5/fig5_analysis.m",
          "url": "https://raw.githubusercontent.com/kaufmanlab/GSK26-public/815b610b3beddfed5a3abf611d3a465ab9e4ce5c/main/fig5/fig5_analysis.m",
          "lines_1_based": [
            18,
            20
          ]
        },
        {
          "source_path": "docs/SUMMARY.md",
          "url": "https://raw.githubusercontent.com/kaufmanlab/GSK26-public/815b610b3beddfed5a3abf611d3a465ab9e4ce5c/docs/SUMMARY.md",
          "lines_1_based": [
            3,
            3
          ]
        }
      ],
      "implementation_requirement": "Authenticate all ten session identities and both regions per mouse; aggregate biological uncertainty at five mice, never ten independent animals."
    },
    {
      "id": "channels",
      "conclusion": "The source has 24 ordered joint channels for jointAngles and the same24 for jointVelocities, with separate decoding conditions. A pooled48-channel endpoint is not the original author analysis.",
      "evidence": [
        {
          "source_path": "utils/loadData.m",
          "url": "https://raw.githubusercontent.com/kaufmanlab/GSK26-public/815b610b3beddfed5a3abf611d3a465ab9e4ce5c/utils/loadData.m",
