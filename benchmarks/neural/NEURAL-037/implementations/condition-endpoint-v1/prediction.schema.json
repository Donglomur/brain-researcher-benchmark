{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "neural037-predictions-v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcomes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "context_id": {
                "type": "string",
                "pattern": "^acquisition_[1-6]_(ABC|CBA)$"
              },
              "status": {
                "const": "complete"
              },
              "responses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cell_key": {
                      "type": "string",
                      "pattern": "^cell_[0-9]{4}$"
                    },
                    "values": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 1000,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "cell_key",
                    "values"
                  ]
                }
              }
            },
            "required": [
              "context_id",
              "status",
              "responses"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "context_id": {
                "type": "string",
                "pattern": "^acquisition_[1-6]_(ABC|CBA)$"
              },
              "status": {
                "const": "abstain"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "context_id",
              "status",
              "reason"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "packet_id",
    "outcomes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "scorer_core.admit is normative for finite typed numeric values, duplicates and complete dynamic context/cell/frame joins before private target access."
}
