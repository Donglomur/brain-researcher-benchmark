{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "neural037-context-v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^acquisition_[1-6]_(ABC|CBA)$"
        },
        "acquisition": {
          "type": "string",
          "pattern": "^acquisition_[1-6]$"
        },
        "query_order": {
          "enum": [
            "ABC",
            "CBA"
          ]
        },
        "cell_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cell_[0-9]{4}$"
          }
        },
        "frames": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        }
      },
      "required": [
        "context_id",
        "acquisition",
        "query_order",
        "cell_keys",
        "frames"
      ]
    },
    "training": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acquisition": {
            "type": "string",
            "pattern": "^acquisition_[1-6]$"
          },
          "order": {
            "enum": [
              "ABC",
              "CBA"
            ]
          },
          "shape": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "means": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^arrays/train_[0-9]{2}_(means|counts)\\.npy$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 80000128
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ]
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^arrays/train_[0-9]{2}_(means|counts)\\.npy$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 80000128
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ]
          }
        },
        "required": [
          "acquisition",
          "order",
          "shape",
          "means",
          "counts"
        ]
      }
    },
    "training_scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "packet_id",
    "query",
    "training",
    "training_scale",
    "scope"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One isolated context only. Source preparation proves exact condition exclusion, shapes and pins; this schema does not enforce external process isolation."
}
