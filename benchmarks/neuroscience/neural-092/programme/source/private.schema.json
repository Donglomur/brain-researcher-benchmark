{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEURAL-092 trusted packet index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "roster_sha256",
    "sessions",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "neuropixels_task_packet_v1"
    },
    "task_id": {
      "const": "NEURAL-092"
    },
    "roster_sha256": {
      "const": "9afc2888bf5200c0362d5adbc951fc90cce2c5e120d58fe00bb83aa5926949fb"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "mouse_id",
          "metadata",
          "counts"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "mouse_id": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "FIT",
              "VALIDATION",
              "QUERY"
            ],
            "properties": {
              "FIT": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "VALIDATION": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "QUERY": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
