{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    }
  },
  "title": "NEURAL055 public case roster only",
  "properties": {
    "schema": {
      "const": "neural055-public-case-v1"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "query_ids": {
      "type": "array",
      "minItems": 200,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "candidate_ids": {
      "type": "array",
      "minItems": 200,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "required": [
    "schema",
    "case_id",
    "query_ids",
    "candidate_ids"
  ],
  "x-runtime-validation": [
    "query/candidate namespaces disjoint",
    "no target join or recording paths in this roster-only descriptor"
  ]
}
