{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "arm",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "const": "NEURAL-012"
    },
    "arm": {
      "enum": [
        "native",
        "harmonized",
        "normalized",
        "timing"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 727,
      "maxItems": 727,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recording_id",
          "scores",
          "events"
        ],
        "properties": {
          "recording_id": {
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "pattern": "^[0-9a-f]{24}$"
          },
          "scores": {
            "type": "array",
            "minItems": 1,
            "maxItems": 86400,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "events": {
            "type": "array",
            "maxItems": 86400,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              }
            }
          }
        }
      }
    }
  }
}
