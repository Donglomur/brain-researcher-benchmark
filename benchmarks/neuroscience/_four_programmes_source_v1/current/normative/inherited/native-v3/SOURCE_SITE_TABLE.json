{
  "bootstrap_fixed_order": [
    "WorkerLaunchAck",
    "DevelopmentRequest",
    "InitialStatePreparation",
    "WorkspaceObservation",
    "LocalBackendProfile",
    "LocalArtifactSelection",
    "NativeContextPolicyV2",
    "NativeArtifactRootSelectionV1",
    "NativeArtifactRootBundleV1",
    "BootstrapEntrySelectionV1",
    "NativeAgentPolicyV3",
    "NativeDevelopmentProfileV3",
    "ChannelBudgetReservationV1",
    "ChannelOpenObservationV1",
    "ChannelPeerObservationV1"
  ],
  "bootstrap_root_tail": "one NativeRootObservation per actual selected root, unique root_id sorted,1..5",
  "host_only_effect_grant_path": "native_context/{condition}/effect_grant_{request_sequence}.json within the original H host Store; fixed closed condition and same pair namespace. The worker receives the actual completed Pin, never projects this string into authority.",
  "limits": "original publisher/metadata/files/caps, explicit finite packet/logical/chunk/sequence admission; lower cap refuses, never resizes scientific scope",
  "selectors": "endpoint fixed health|slots|completion; ordinal within original stage caps; artifact role in exact five-role ordered selection; snapshot exactly0,1,2; process exactly0,1; no supplied path",
  "semantic_request_order": [
    "actual admitted backend and original PendingAgentStep",
    "actual selected input-ABI/transcript capture",
    "actual selected renderer return",
    "rendered_template actual H publication/readback/ack",
    "completion_request actual H publication/readback/ack",
    "same WorkerCapturedRecord into BackendAttemptHandle.complete_v1",
    "same pending into LocalHttpExchange.run",
    "later BackendHttpRequest"
  ],
  "site_count": 25,
  "sites": {
    "agent_completion": {
      "kind": "AgentCompletion",
      "path": "worker/agent_completion_{ordinal}.json"
    },
    "artifact": {
      "kind": "ArtifactObservation",
      "path": "worker/artifact_{role}.json"
    },
    "base": {
      "kind": "BackendAttemptBase",
      "path": "worker/backend_attempt_base.json"
    },
    "closure": {
      "kind": "BackendClosure",
      "path": "worker/backend_closure.json"
    },
    "completion_request": {
      "caller": "backend_agent_entry.prepare_completion_request_v2",
      "cutoff": "original G, no renewed clock",
      "kind": "CompletionRequest",
      "ordinal": "same actual PendingAgentStep / backend.requests next ordinal; no reused failed attempt",
      "path": "worker/completion_request_{ordinal}.json",
      "phase": "C18R"
    },
    "environment": {
      "kind": "EnvironmentObservation",
      "path": "worker/backend_environment.json"
    },
    "exchange": {
      "kind": "BackendExchangeObservation",
      "path": "worker/backend_exchange_{ordinal}.json"
    },
    "exit": {
      "kind": "ExitObservation",
      "path": "worker/backend_exit.json"
    },
    "http_completion": {
      "kind": "ParsedCompletion",
      "path": "worker/http_completion_{ordinal}_parsed.json"
    },
    "http_health": {
      "kind": "ParsedHealth",
      "path": "worker/http_health_{ordinal}_parsed.json"
    },
    "http_raw": {
      "kind": "RawHttpResponse",
      "path": "worker/http_{endpoint}_{ordinal}_raw.json"
    },
    "http_rejected": {
      "kind": "RejectedResponse",
      "path": "worker/http_{endpoint}_{ordinal}_rejected.json"
    },
    "http_request": {
      "kind": "BackendHttpRequest",
      "path": "worker/http_{endpoint}_{ordinal}_request.json"
    },
    "http_slots": {
      "kind": "ParsedSlots",
      "path": "worker/http_slots_{ordinal}_parsed.json"
    },
    "initialization": {
      "kind": "BackendInitializationObservation",
      "path": "worker/backend_initialization.json"
    },
    "peer": {
      "kind": "PeerCredentialObservation",
      "path": "worker/backend_peer.json"
    },
    "process": {
      "kind": "ProcessObservation",
      "path": "worker/backend_process_{ordinal}.json"
    },
    "rendered_template": {
      "caller": "backend_agent_entry.prepare_completion_request_v2",
      "cutoff": "original G, no renewed clock",
      "kind": "RenderedTemplateObservation",
      "ordinal": "same actual PendingAgentStep / backend.requests next ordinal; no reused failed attempt",
      "path": "worker/rendered_template_{ordinal}.json",
      "phase": "C18R"
    },
    "signal": {
      "kind": "SignalObservation",
      "path": "worker/backend_signal.json"
    },
    "snapshot": {
      "kind": "BackendAttempt",
      "path": "worker/backend_attempt_snapshot_{ordinal}.json"
    },
    "socket": {
      "kind": "SocketObservation",
      "path": "worker/backend_socket.json"
    },
    "socket_closure": {
      "kind": "SocketClosureObservation",
      "path": "worker/backend_socket_closure.json"
    },
    "source_initialization": {
      "kind": "SourceInitializationProof",
      "path": "worker/backend_source_initialization.json"
    },
    "streams": {
      "kind": "StreamClosureObservation",
      "path": "worker/backend_streams.json"
    },
    "subtree": {
      "kind": "SubtreeObservation",
      "path": "worker/backend_subtree.json"
    }
  }
}
