{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "time_seconds",
    "pairs"
  ],
  "properties": {
    "schema": {
      "const": "neural029-public-v1"
    },
    "time_seconds": {
      "const": [
        0.0,
        0.05,
        0.1,
        0.15,
        0.2,
        0.25,
        0.3,
        0.35,
        0.4,
        0.45,
        0.5,
        0.55,
        0.6,
        0.65,
        0.7,
        0.75,
        0.8,
        0.85,
        0.9,
        0.95,
        1.0,
        1.05,
        1.1,
        1.15,
        1.2,
        1.25,
        1.3,
        1.35,
        1.4,
        1.45,
        1.5,
        1.55,
        1.6,
        1.65,
        1.7,
        1.75,
        1.8,
        1.85,
        1.9,
        1.95,
        2.0,
        2.05,
        2.1,
        2.15,
        2.2,
        2.25,
        2.3,
        2.35,
        2.4,
        2.45,
        2.5,
        2.55,
        2.6,
        2.65,
        2.7,
        2.75,
        2.8,
        2.85,
        2.9,
        2.95,
        3.0
      ]
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "cell_ids",
          "query_ids",
          "source_delay_seconds",
          "target_delay_seconds",
          "reward_type",
          "calibration_trials",
          "validation_trials",
          "file"
        ],
        "properties": {
          "pair_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cell_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "query_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "source_delay_seconds": {
            "const": 1
          },
          "target_delay_seconds": {
            "const": 2
          },
          "reward_type": {
            "enum": [
              "DAT",
              "MFB"
            ]
          },
          "calibration_trials": {
            "type": "integer",
            "minimum": 4
          },
          "validation_trials": {
            "type": "integer",
            "minimum": 1
          },
          "file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
