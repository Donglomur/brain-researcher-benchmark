{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pairs"
  ],
  "properties": {
    "schema": {
      "const": "neural029-targets-v2"
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "mouse_id",
          "file",
          "training_scale_squared"
        ],
        "properties": {
          "pair_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mouse_id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "training_scale_squared": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "description": "Operator-only v2 target manifest. Each bound NPZ contains exactly target.npy, baseline.npy (absolute mean), and fixed_warp_baseline.npy as float64. Identity is separately mandatory in binding-v2; public/submission v1 unchanged."
}
