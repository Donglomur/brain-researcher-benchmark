{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "predictions"
  ],
  "properties": {
    "schema": {
      "const": "neural029-predictions-v1"
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "values"
        ],
        "properties": {
          "pair_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 61,
                "maxItems": 61,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
