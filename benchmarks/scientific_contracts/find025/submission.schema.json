{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "submission.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "find025_submission_v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "enum": [
        "paper_data/candidate",
        "paper_data/baseline",
        "paper_data_code/candidate",
        "paper_data_code/baseline"
      ]
    },
    "procedure_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "access_used": {
      "type": "object",
      "properties": {
        "official_code": {
          "type": "boolean"
        },
        "historical_rank_table": {
          "type": "boolean"
        },
        "historical_motion_threshold": {
          "type": "boolean"
        },
        "saved_reference_outputs": {
          "type": "boolean"
        },
        "evaluation_targets": {
          "type": "boolean"
        }
      },
      "required": [
        "official_code",
        "historical_rank_table",
        "historical_motion_threshold",
        "saved_reference_outputs",
        "evaluation_targets"
      ],
      "additionalProperties": false
    },
    "predictor_intervention_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_declaration": {
      "type": "object",
      "properties": {
        "resource_ceiling_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "target_visibility_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "split_realization_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "fit_transform_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen_procedure_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_rerun_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "resource_ceiling_id",
        "target_visibility_id",
        "split_realization_id",
        "fit_transform_record_id",
        "frozen_procedure_id",
        "baseline_rerun_id"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "enum": [
              "complete",
              "failed",
              "undefined",
              "abstained"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "identity": {
            "type": "object",
            "properties": {
              "metric_id": {
                "enum": [
                  null,
                  "signed_variance_explained_v1",
                  "pearson_squared_delay_trialmeans_git003835_v1",
                  "normalized_subspace_variance_v1",
                  "binary_accuracy_v1",
                  "first_strict_90pct_latency_v1",
                  "artifact_only_v1",
                  "pearson_squared_paired_vector_v1"
                ]
              },
              "metric_unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "paper_code_version_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "condition_dictionary_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "condition_selection_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome_definition_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_selection_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "time_grid_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bin_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "score_window_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trace_orientation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "smoothing_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "delay_onset_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "normalization_denominator_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fit_support_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "development_support_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evaluation_support_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scoring_rows_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_preprocessing_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dispatch_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "argument_binding_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "repair_recipe_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rank_policy_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rank_fit_support_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rank_privilege": {
                "enum": [
                  null,
                  "train_only",
                  "historical_full_session",
                  "historical_precomputed"
                ]
              },
              "threshold_policy_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "threshold_fit_support_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "threshold_privilege": {
                "enum": [
                  null,
                  "train_only",
                  "historical_full_session",
                  "historical_precomputed"
                ]
              },
              "split_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "missing_policy_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "aggregation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "metric_id",
              "metric_unit",
              "paper_code_version_id",
              "condition_dictionary_id",
              "condition_selection_id",
              "outcome_definition_id",
              "target_id",
              "unit_selection_id",
              "time_grid_id",
              "bin_seconds",
              "score_window_id",
              "trace_orientation_id",
              "smoothing_id",
              "delay_onset_id",
              "normalization_denominator_id",
              "fit_support_id",
              "development_support_id",
              "evaluation_support_id",
              "scoring_rows_id",
              "target_preprocessing_id",
              "dispatch_id",
              "argument_binding_id",
              "repair_recipe_id",
              "rank_policy_id",
              "rank_fit_support_id",
              "rank_privilege",
              "threshold_policy_id",
              "threshold_fit_support_id",
              "threshold_privilege",
              "split_id",
              "missing_policy_id",
              "aggregation_id"
            ],
            "additionalProperties": false
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "logical_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "logical_id",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "case_id",
          "status",
          "reason",
          "identity",
          "artifacts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "plan_sha256",
    "run_id",
    "procedure_id",
    "access_used",
    "predictor_intervention_id",
    "execution_declaration",
    "records"
  ],
  "additionalProperties": false
}
