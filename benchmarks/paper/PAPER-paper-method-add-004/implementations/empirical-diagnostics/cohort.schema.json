{
  "$comment": "Field-level contract only. Production additionally requires unique unit IDs and exactly26 distinct mouse IDs. It does not authenticate cohort authority from counts or source_sha256. Strict JSON rejects duplicate keys and nonfinite literals.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "isttc_empirical_cohort_v1"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "units": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "area": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "fr_hz": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "lv": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "mouse_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "session_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "unit_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "unit_id",
          "mouse_id",
          "session_id",
          "area",
          "fr_hz",
          "lv"
        ],
        "type": "object"
      },
      "maxItems": 5775,
      "minItems": 5775,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "source_sha256",
    "units"
  ],
  "type": "object"
}
