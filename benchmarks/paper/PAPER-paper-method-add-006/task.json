{
  "schema_version": 1,
  "id": "PAPER-paper-method-add-006",
  "track": "paper",
  "title": "Neural population geometry and optimal coding of tasks with shared latent structure",
  "status": "design_ready",
  "objective": "surpass_source_paper_same_task",
  "goal": "Surpass the source-paper result on the same task: Predict source single-unit 500-ms spike counts from navigation covariates in both rat PFC and CA1; improve the original cross-validated predictive fit. Geometry trends, theory agreement and stronger mixed-effects significance are supporting reproduction outputs, not ordered improvement outcomes.",
  "primary_outputs": [
    "Candidate method and outputs for the source task: Predict source single-unit 500-ms spike counts from navigation covariates in both rat PFC and CA1; improve the original cross-validated predictive fit. Geometry trends, theory agreement and stronger mixed-effects significance are supporting reproduction outputs, not ordered improvement outcomes.",
    "Source-paper comparison for Cross-validated population Poisson D2, separately for PFC and CA1: Higher cross-validated Poisson deviance explained D2 = 1 - D(y,mu)/D(y,mean(y)); D is Poisson deviance with the zero-count log contribution set to zero. Preserve the source PoissonRegressor scoring/null convention, invalid-fold handling and both regional outputs."
  ],
  "success_criteria": [
    "Reconstruct the original eight-rat/eight-session PFC and CA1 populations and author folds, masks, covariates and score aggregation; reconcile every paper/code discrepancy affecting the endpoint.",
    "Reproduce the author source D2 = 0.29 for PFC and 0.25 for CA1 within a separately justified calibration tolerance before testing a frozen candidate.",
    "Exceed the source result under a predeclared meaningful-effect and uncertainty policy covering both regions, with equal allowed inputs and fixed training/selection resources; report every regional outcome.",
    "Do not count a new held-animal split, easier prediction covariates, a selected session subset, a better p-value or a changed geometric statistic as surpassing this source task.",
    "The bound improvement contract must be improvement_ready and its complete same-task comparison and admission requirements must pass.",
    "Reproduction is calibration only; reconstructing a numerical result, changing the task or split, or achieving stronger significance alone is not success."
  ],
